# Gemini API key — used ONLY by the server-side /api/ai-upscale route.
# Get yours free at https://aistudio.google.com/apikey
# Never prefix with NEXT_PUBLIC_ — the key must stay server-only.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini image model.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
